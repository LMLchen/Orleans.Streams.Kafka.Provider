<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Orleans.Streams.Kafka</RootNamespace>

    <!-- NuGet Package Metadata -->
    <PackageId>Orleans.Streams.Kafka.Provider</PackageId>
    <Version>2.0.1</Version>
    <Authors>Orleans.Streams.Kafka Contributors</Authors>
    <Description>A Kafka Stream Provider for Microsoft Orleans. Enables Orleans Grains to produce and consume messages via Apache Kafka.</Description>
    <PackageTags>orleans;kafka;streaming;distributed;actor</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageProjectUrl>https://github.com/your-org/Orleans.Streams.Kafka</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Orleans.Streaming" Version="[8.0.0,9.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[8.0.0,9.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Orleans.Streaming" Version="[9.0.0,10.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[9.0.0,10.0.0)" />
  </ItemGroup>

</Project>
